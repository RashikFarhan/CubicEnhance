    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        let ytPlayer;
        function onYouTubeIframeAPIReady() {
            ytPlayer = new YT.Player('youtube-player', {
                events: {
                    'onReady': onPlayerReady
                }
            });
        }

        function onPlayerReady(event) {
            const muteBtn = document.getElementById('yt-mute-btn');
            const fsBtn = document.getElementById('yt-fs-btn');
            const iconMuted = document.getElementById('yt-icon-muted');
            const iconUnmuted = document.getElementById('yt-icon-unmuted');
            const iframe = document.getElementById('youtube-player');

            if(muteBtn) {
                muteBtn.addEventListener('click', () => {
                    if (ytPlayer.isMuted()) {
                        ytPlayer.unMute();
                        iconMuted.classList.add('hidden');
                        iconUnmuted.classList.remove('hidden');
                    } else {
                        ytPlayer.mute();
                        iconMuted.classList.remove('hidden');
                        iconUnmuted.classList.add('hidden');
                    }
                });
            }

            if(fsBtn) {
                fsBtn.addEventListener('click', () => {
                    if (iframe.requestFullscreen) {
                        iframe.requestFullscreen();
                    } else if (iframe.mozRequestFullScreen) {
                        iframe.mozRequestFullScreen();
                    } else if (iframe.webkitRequestFullscreen) {
                        iframe.webkitRequestFullscreen();
                    } else if (iframe.msRequestFullscreen) {
                        iframe.msRequestFullscreen();
                    }
                });
            }
        }
    </script>
